set $mod Mod4
set $term wezterm
set $menu rofi -show drun

input "type:keyboard" {
    xkb_layout us
}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
}

bindsym $mod+t exec $term
bindsym $mod+r exec $menu
bindsym $mod+w kill

exec_always --no-startup-id ~/.config/sway/scripts/fullscreen.sh

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

exec sh -c 'systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP && exec systemctl --user start kodi.service'
